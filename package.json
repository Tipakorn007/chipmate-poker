{
  "name": "chipmate-poker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chipmate — Texas Hold'em UI prototype with play chips only",
  "scripts": {
    "dev": "vite",
    "server": "bun run server/index.ts",
    "test": "bun test",
    "build": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
